# Kickbase auth token, sent as `Authorization: Bearer <KB_TOKEN>`.
# Kickbase has NO web version — it's mobile-app-only by design, so there is no
# browser cookie to copy. Two ways to obtain a token:
#
# 1. Email/password accounts only: POST { "em": "<email>", "pass": "<password>" }
#    to https://api.kickbase.com/v4/user/login and read the token from the
#    response body. Does not work for Apple/Google Sign-In accounts (no
#    separate password exists for those).
#
# 2. Any account (incl. Apple/Google Sign-In): capture it from the app's own
#    network traffic with a local MITM proxy (e.g. HTTP Toolkit) — open the
#    Kickbase app with the proxy active, find any api.kickbase.com request,
#    and copy the value after "Bearer " from its Authorization header.
#
# Never commit the real value. Short-lived (~1 hour observed) — expect to
# refresh it often; the client surfaces a clear re-auth error on 401/403
# rather than a cryptic failure.
KB_TOKEN=

# Numeric/string ID of your Kickbase league. Found in the league URL
# (e.g. app.kickbase.com/leagues/<LEAGUE_ID>/...).
LEAGUE_ID=

# Opt-in for the BaseXI integration (get-basexi-player-snapshot tool). OFF by
# default and should stay off unless you've read CLAUDE.md's "External data
# sources" section: base-xi.de's own robots.txt disallows automated access to
# /api/, so enabling this is a deliberate personal choice, not a default.
# Set to the literal string "true" to enable; anything else (including unset)
# leaves it disabled.
ENABLE_BASEXI=

# Where forecast-kickbase-matchday-value-lineup logs its predictions, so
# review-kickbase-forecast-accuracy can later diff them against real results.
# Defaults to ./.kickbase-forecast-log (git-ignored) when unset.
FORECAST_LOG_DIR=
