# Kickbase session cookie. Obtain by logging into kickbase.de in a browser,
# then copying the `kkstrauth` (or equivalent auth) cookie value from devtools.
# Never commit the real value. Expires periodically — the client should surface
# a clear "cookie expired, please refresh" error rather than a cryptic 401.
KB_COOKIE=

# Numeric/string ID of your Kickbase league. Found in the league URL
# (e.g. app.kickbase.com/leagues/<LEAGUE_ID>/...).
LEAGUE_ID=

# Opt-in for the BaseXI integration (get-basexi-player-snapshot tool). OFF by
# default and should stay off unless you've read CLAUDE.md's "External data
# sources" section: base-xi.de's own robots.txt disallows automated access to
# /api/, so enabling this is a deliberate personal choice, not a default.
# Set to the literal string "true" to enable; anything else (including unset)
# leaves it disabled.
ENABLE_BASEXI=
